<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Arial, Helvetica, sans-serif; color: #222; background: #f7f7f7; margin: 0; padding: 20px; }
  h1 { font-size: 18px; margin: 0 0 4px 0; }
  .subtitle { color: #666; font-size: 13px; margin: 0 0 20px 0; }
  table { border-collapse: collapse; width: 100%; background: #fff; font-size: 12px; }
  th, td { border: 1px solid #ddd; padding: 6px 8px; text-align: left; vertical-align: top; }
  th { background: #2c3e50; color: #fff; position: sticky; top: 0; }
  tr.primary { background: #eaf2fb; }
  tr.primary td:first-child { font-weight: bold; }
  .table-wrap { overflow-x: auto; }
  .warnings { margin-top: 24px; }
  .warnings h2 { font-size: 15px; margin-bottom: 8px; }
  .warnings ul { font-size: 12px; color: #7a4b00; background: #fff8e6; border: 1px solid #f0dca0; padding: 12px 12px 12px 28px; border-radius: 4px; }
  .warnings li { margin-bottom: 4px; }
  .empty-note { color: #888; font-size: 12px; margin-top: 20px; }
</style>
</head>
<body>
  <h1>{{ subject }}</h1>
  <p class="subtitle">Generated {{ generated_at }}. Rows for {{ primary_institution }} are highlighted for quick reference.</p>

  {% if rows %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Institution</th>
        <th>Card</th>
        {% for _, label in fields %}
        <th>{{ label }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr class="{{ 'primary' if row.is_primary else '' }}">
        <td>{{ row.institution }}</td>
        <td>{{ row.card_name }}</td>
        {% for key, _ in fields %}
        <td>{{ row.card.get(key, "Not disclosed") }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty-note">No card data was available for this run.</p>
  {% endif %}

  {% if warnings %}
  <div class="warnings">
    <h2>Data Quality Notes</h2>
    <ul>
      {% for warning in warnings %}
      <li>{{ warning }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</body>
</html>
